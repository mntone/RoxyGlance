root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
tab_width = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[app.manifest]
insert_final_newline = false

[{Package.appxmanifest,packages.config,*.props,*.slnx,*.targets,*.vcxproj,*.vcxproj.filters}]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = false
