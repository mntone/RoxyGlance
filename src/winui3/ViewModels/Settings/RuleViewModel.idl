import "ViewModels/Settings/ActionViewModel.idl";
import "ViewModels/Settings/StringFilterViewModel.idl";
import "ViewModels/Settings/TriggersViewModel.idl";

namespace Mntone.RoxyGlance.ViewModels.Settings
{
  [bindable]
  [default_interface]
  [marshaling_behavior(none)]
  runtimeclass RuleViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
  {
    [noexcept] ActionViewModel Action { get; };
    ActionType ActionType;
    [noexcept] Microsoft.UI.Xaml.Input.ICommand AddFilterCommand { get; };
    [noexcept] Windows.Foundation.Collections.IObservableVector<StringFilterViewModel> Filters { get; };
    [noexcept] String Name { get; };
    [noexcept] TriggersViewModel Triggers { get; };
    [noexcept] Windows.Foundation.Collections.IObservableVector<FilterKeyViewModel> UnusedFilterKeys { get; };
  }
}
