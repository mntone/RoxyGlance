<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Mntone.RoxyGlance.Views.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodels="using:Mntone.RoxyGlance.ViewModels.Logging"
      mc:Ignorable="d">

  <ListView ItemsSource="{x:Bind Logs.Logs, Mode=OneTime}"
            SelectionMode="None">
    <ListView.ItemTemplate>
      <DataTemplate x:DataType="viewmodels:LogViewModel">
        <TextBlock Text="{x:Bind Content}"
                   TextWrapping="Wrap"
                   Margin="0,8" />
      </DataTemplate>
    </ListView.ItemTemplate>
  </ListView>
</Page>
