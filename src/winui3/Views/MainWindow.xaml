<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Mntone.RoxyGlance.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Mntone.RoxyGlance.ViewModels"
        mc:Ignorable="d"
        Title="Roxy Glance">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <ListView Grid.Row="1"
              ItemsSource="{x:Bind Logs.Logs, Mode=OneTime}"
              SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:LogViewModel">
          <TextBlock Text="{x:Bind Content}"
                     TextWrapping="Wrap"
                     Margin="0,8" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Window>
